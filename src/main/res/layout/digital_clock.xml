<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp" >

    <LinearLayout
        android:id="@+id/ladder_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:orientation="vertical" >
        <TextView android:id="@+id/l0" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView android:id="@+id/l1" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView android:id="@+id/l2" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView android:id="@+id/l3" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView android:id="@+id/l4" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView android:id="@+id/l5" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ladder_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:gravity="right" >
        <TextView android:id="@+id/r0" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView android:id="@+id/r1" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView android:id="@+id/r2" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView android:id="@+id/r3" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView android:id="@+id/r4" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
        <TextView android:id="@+id/r5" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/koku_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/bell_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/koku_big"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:textSize="20sp"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:id="@+id/civil_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/bell_line"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:textSize="14sp"
        android:alpha="0.5"
        android:textColor="?android:attr/textColorSecondary" />

</RelativeLayout>
